rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Roles
    match /users/{email} {
      allow read: if request.auth != null;
      // Allow create if user is self and role is worker
      allow create: if request.auth != null && request.auth.token.email == email && request.resource.data.role == 'worker';
      // Allow update if user is self and role is not changing
      allow update: if request.auth != null && request.auth.token.email == email && request.resource.data.role == resource.data.role;
      // Allow write (create/update/delete) if the requester is an admin
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Workers & Projects - Read accessible to all auth users
    // Write only for admins
    match /workers/{worker} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }
    
    match /projects/{project} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Incident Reports
    // - Any authenticated user can create a report
    // - Users can read their own submissions
    // - Admins can read all reports and update them (approve/reject)
    match /incident_reports/{reportId} {
      // Allow create only if the 'submittedBy' field matches the authenticated user's email
      allow create: if request.auth != null && request.resource.data.submittedBy == request.auth.token.email;
      allow read: if request.auth != null && 
        (resource.data.submittedBy == request.auth.token.email || 
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin');
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
      allow delete: if false; // Reports should not be deleted, only archived
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
