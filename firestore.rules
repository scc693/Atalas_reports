rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Roles
    match /users/{email} {
      allow read: if request.auth != null;
      // Allow write if the requester is an admin
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Workers & Projects - Read accessible to all auth users
    // Write only for admins
    match /workers/{worker} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }
    
    match /projects/{project} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
